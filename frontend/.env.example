# Copie este arquivo para .env (ele não vai para o GitHub).
#
# Endereço da API. Se ficar vazio, o front usa dados simulados no navegador
# (modo demonstração), útil enquanto o back-end ainda não está pronto.
#   Local:     VITE_API_URL=http://localhost:8000
#   Produção:  VITE_API_URL=https://SEU-APP.onrender.com
VITE_API_URL=

# Força o modo demonstração mesmo com a API configurada (true ou false).
VITE_USE_MOCK=false
